# Local state and plans must never be pushed.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
terraform.tfvars
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
backend.hcl
backend-*.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# .terraform.lock.hcl is intentionally tracked.

